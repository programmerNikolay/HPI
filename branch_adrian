IGIC = 0.07  # General IGIC rate: 7 %


def is_item(element):
    """An item is a list [name, price]."""
    return (
        isinstance(element, list)
        and len(element) == 2
        and isinstance(element[0], str)
        and isinstance(element[1], (int, float))
    )


def find_item(catalog, name):
    """Traverse the catalog depth-first (DFS) and return [name, price], or None."""
    if is_item(catalog):
        if catalog[0].lower() == name.strip().lower():
            return catalog
        return None

    if isinstance(catalog, dict):
        children = catalog.values()
    elif isinstance(catalog, list):
        children = catalog
    else:
        return None

    for child in children:
        found = find_item(child, name)
        if found:
            return found
    return None


def add_item(cart, item):
    """Add the item [name, price] to the cart."""
    if item:
        cart.append(item)


def calculate_price(cart):
    """Print the cart with subtotal, IGIC and total. Return the total."""
    subtotal = 0
    for name, price in cart:
        print(f"{name:<15}{price:>8.2f} €")
        subtotal += price

    tax = subtotal * IGIC
    total = subtotal + tax

    print("-" * 23)
    print(f"{'Subtotal':<15}{subtotal:>8.2f} €")
    print(f"{'IGIC (7%)':<15}{tax:>8.2f} €")
    print(f"{'TOTAL':<15}{total:>8.2f} €")
    return total
